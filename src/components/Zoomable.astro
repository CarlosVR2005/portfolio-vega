---
/** Imagen ampliable: enlaza a una versión grande que abre el Lightbox. */
import { getImage } from 'astro:assets';
import Image from './Img.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  zoomLabel?: string;
}
const { src, alt, caption, sizes, widths = [480, 800, 1200], class: cls, loading = 'lazy', zoomLabel = 'Ampliar' } = Astro.props;
const ws = widths.filter((w) => w < src.width);
ws.push(Math.min(src.width, Math.max(...widths)));
const big = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' });
---

<a href={big.src} class:list={['zoomable', cls]} data-lightbox data-astro-reload data-caption={caption} data-cursor-label={zoomLabel}>
  <Image src={src} alt={alt} sizes={sizes} widths={[...new Set(ws)]} loading={loading} />
</a>

<style>
  .zoomable {
    display: block;
    overflow: hidden;
  }
  .zoomable :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: scale 0.8s var(--ease-out-expo);
  }
  .zoomable:hover :global(img) {
    scale: 1.03;
  }
</style>
