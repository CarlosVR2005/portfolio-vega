---
// Cursor personalizado: el script solo lo activa con puntero fino (ratón).
---
<div class="cursor-layer" aria-hidden="true" transition:persist="cursor">
  <span class="cursor-grain"></span>
  <span class="cursor-grain"></span>
  <span class="cursor-grain"></span>
  <div id="cursor" data-kind="dot">
    <span class="cursor-shape">
      <svg class="cursor-pen" viewBox="0 0 24 24" width="26" height="26">
        <path d="M3 21l2.6-6.8L16.9 2.9a2 2 0 012.8 0l1.4 1.4a2 2 0 010 2.8L9.8 18.4 3 21z" fill="currentColor" />
        <path d="M5.6 14.2l4.2 4.2" stroke="var(--bg)" stroke-width="1.3" />
        <circle cx="3.6" cy="20.4" r="1.1" fill="var(--bg)" />
      </svg>
    </span>
    <span class="cursor-label"></span>
  </div>
</div>

<script>
  import '../scripts/cursor';
</script>

<style is:global>
  .cursor-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 200;
    display: none;
  }
  html.has-cursor .cursor-layer {
    display: block;
  }
  html.has-cursor,
  html.has-cursor * {
    cursor: none !important;
  }
  html.has-cursor input,
  html.has-cursor textarea {
    cursor: text !important;
  }

  #cursor {
    position: fixed;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 0.3s;
    color: var(--fg);
  }
  #cursor.is-visible {
    opacity: 1;
  }
  #cursor.is-text {
    opacity: 0;
  }
  .cursor-shape {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    transition:
      width 0.35s var(--ease-out-expo),
      height 0.35s var(--ease-out-expo),
      background 0.3s,
      border-radius 0.3s,
      box-shadow 0.3s,
      scale 0.2s;
  }
  #cursor.is-down .cursor-shape {
    scale: 0.75;
  }
  #cursor.is-hover .cursor-shape {
    width: 44px;
    height: 44px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .cursor-pen {
    display: none;
  }
  .cursor-label {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.3s,
      scale 0.4s var(--ease-out-expo);
  }
  #cursor.is-label .cursor-shape {
    width: 96px;
    height: 96px;
  }
  #cursor.is-label .cursor-label {
    opacity: 1;
    scale: 1;
    color: var(--bg);
  }

  /* POLAS — punta de bolígrafo */
  #cursor[data-kind='pen'] .cursor-shape {
    background: transparent;
    width: 26px;
    height: 26px;
    translate: -3px -23px; /* la punta está en la esquina inferior izquierda */
    border-radius: 0;
  }
  #cursor[data-kind='pen'] .cursor-pen {
    display: block;
  }
  #cursor[data-kind='pen'].is-label .cursor-shape {
    translate: -3px -23px;
  }
  #cursor[data-kind='pen'] .cursor-label {
    translate: 14px 10px;
    color: var(--fg) !important;
    background: none;
  }

  /* GOAB — grano de arena con estela */
  #cursor[data-kind='sand'] .cursor-shape {
    width: 9px;
    height: 7px;
    border-radius: 45% 55% 40% 60%;
    background: #cfaa72;
    rotate: 25deg;
  }
  #cursor[data-kind='sand'].is-label .cursor-shape {
    width: 96px;
    height: 96px;
    border-radius: 48% 52% 46% 54%;
    rotate: 0deg;
  }
  .cursor-grain {
    position: fixed;
    top: 0;
    left: 0;
    width: 4px;
    height: 3px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: #cfaa72;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor-grain:nth-child(2) {
    width: 3px;
    height: 3px;
    background: #a37b4f;
  }
  .cursor-grain:nth-child(3) {
    width: 2px;
    height: 2px;
    background: #f8eaae;
  }
  .cursor-layer:has(#cursor[data-kind='sand'].is-visible:not(.is-label)) .cursor-grain {
    opacity: 0.9;
  }

  /* Starbucks — destello cálido */
  #cursor[data-kind='glow'] .cursor-shape {
    width: 12px;
    height: 12px;
    background: #fff4dc;
    box-shadow:
      0 0 12px 4px rgba(255, 196, 120, 0.75),
      0 0 40px 14px rgba(209, 113, 59, 0.35);
  }
  #cursor[data-kind='glow'].is-label .cursor-shape {
    width: 96px;
    height: 96px;
    background: #f6ebe1;
  }
  #cursor[data-kind='glow'].is-label .cursor-label {
    color: #2a3257;
  }
</style>
