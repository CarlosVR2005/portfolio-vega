---
import Image from './Img.astro';
import { getCollection } from 'astro:content';
import { t, projectHref, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const effects: Record<string, string> = { sand: 'sand', ink: 'hatch', dusk: 'dusk', plain: 'fade' };
---

<section class="work" id={locale === 'es' ? 'obra' : 'work'} aria-labelledby="work-title">
  <div class="wrap work-head">
    <h2 id="work-title" class="display work-title" data-split>{t(locale, 'work.title')}</h2>
    <p class="work-intro">{t(locale, 'work.intro')}</p>
  </div>

  <ol class="panels" role="list">
    {
      projects.map((p, i) => {
        const d = p.data;
        const w = d.world;
        return (
          <li class="panel-item">
            <a
              href={projectHref(locale, d.slug)}
              class="panel"
              data-effect={effects[w.transition]}
              data-transition={w.transition}
              data-wipe={w.wipe}
              data-cursor={w.cursor}
              data-cursor-label={locale === 'es' ? 'Ver' : 'View'}
              style={`--p-bg:${w.bg};--p-ink:${w.ink};--p-accent:${w.accent};--p-muted:${w.muted};`}
            >
              <div class="panel-media">
                <Image
                  class="m-base"
                  src={d.cover.src}
                  alt=""
                  widths={[480, 800, 1200, 1680]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  style={`object-position:${d.cover.position}`}
                />
                <Image
                  class="m-reveal"
                  src={d.cover.src}
                  alt={d.cover.alt[locale]}
                  widths={[480, 800, 1200, 1680]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  style={`object-position:${d.cover.position}`}
                />
              </div>
              <div class="panel-text">
                <span class="panel-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="eyebrow panel-kicker">{d.kicker[locale]}</p>
                <h3 class="display panel-title">{d.title}</h3>
                <p class="panel-teaser">{d.teaser[locale]}</p>
                <p class="panel-meta">
                  <span>{d.discipline[locale]}</span>
                  <span aria-hidden="true">·</span>
                  <span>{d.year}</span>
                </p>
                {d.disclaimer && <p class="panel-disclaimer">{d.disclaimer[locale]}</p>}
                <span class="panel-cta">
                  {t(locale, 'work.view')} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<script>
  import { onPage, gsap, reducedMotion } from '../scripts/motion';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  onPage(() => {
    const section = document.querySelector<HTMLElement>('.work');
    if (!section) return;
    const panels = gsap.utils.toArray<HTMLElement>('.panel', section);

    // Cursor → posición del reveal radial (GOAB)
    const onMove = (e: PointerEvent) => {
      const el = e.currentTarget as HTMLElement;
      const media = el.querySelector<HTMLElement>('.panel-media')!;
      const r = media.getBoundingClientRect();
      media.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      media.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    };
    panels.forEach((p) => p.addEventListener('pointermove', onMove));

    // Táctil / sin hover: el reveal ocurre al entrar en pantalla.
    const noHover = !window.matchMedia('(hover: hover)').matches;
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (en.isIntersecting && (noHover || reducedMotion())) en.target.classList.add('is-revealed');
        }),
      { threshold: 0.45 },
    );
    panels.forEach((p) => io.observe(p));

    if (!reducedMotion()) {
      const title = section.querySelector<HTMLElement>('[data-split]')!;
      const split = SplitText.create(title, { type: 'words,chars', mask: 'words' });
      gsap.from(split.chars, {
        yPercent: 110,
        duration: 0.9,
        ease: 'expo.out',
        stagger: 0.025,
        scrollTrigger: { trigger: title, start: 'top 85%' },
      });
      panels.forEach((p) => {
        gsap.from(p, {
          y: 80,
          autoAlpha: 0,
          duration: 1.1,
          ease: 'expo.out',
          scrollTrigger: { trigger: p, start: 'top 88%' },
        });
        gsap.fromTo(
          p.querySelectorAll('.panel-media img'),
          { yPercent: -6, scale: 1.12 },
          { yPercent: 6, scale: 1.12, ease: 'none', scrollTrigger: { trigger: p, start: 'top bottom', end: 'bottom top', scrub: true } },
        );
      });
      return () => {
        split.revert();
        io.disconnect();
      };
    }
    return () => io.disconnect();
  });
</script>

<style>
  .work {
    position: relative;
    z-index: 2;
    padding-block: clamp(4rem, 12vw, 10rem) clamp(3rem, 8vw, 6rem);
    scroll-margin-top: 1rem;
  }
  .work-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 6vw, 5rem);
  }
  .work-title {
    font-size: var(--step-4);
  }
  .work-intro {
    color: var(--fg-soft);
    font-size: var(--step-1);
    max-width: 30ch;
  }
  @media (min-width: 900px) {
    .work-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .work-intro {
      text-align: right;
    }
  }

  .panels {
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    list-style: none;
    margin: 0;
  }
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    background: var(--p-bg);
    color: var(--p-ink);
    overflow: hidden;
    isolation: isolate;
  }
  .panel:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 4px;
  }

  /* ---- Media con dos capas: base (estado latente) + reveal ---- */
  .panel-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    --mx: 50%;
    --my: 50%;
  }
  .panel-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* POLAS — rayado de bolígrafo que se va rellenando */
  [data-effect='hatch'] .m-base {
    opacity: 0.16;
    filter: grayscale(1);
  }
  [data-effect='hatch'] .m-reveal {
    -webkit-mask-image: repeating-linear-gradient(-38deg, #000 0 var(--hatch), transparent var(--hatch) 10px);
    mask-image: repeating-linear-gradient(-38deg, #000 0 var(--hatch), transparent var(--hatch) 10px);
    transition: --hatch 0.9s var(--ease-in-out-quart);
  }
  [data-effect='hatch']:is(:hover, :focus-visible, .is-revealed) .m-reveal {
    --hatch: 10.5px;
  }

  /* GOAB — la arena se aparta desde el cursor */
  [data-effect='sand'] .m-base {
    filter: sepia(0.7) brightness(0.42) blur(3px) contrast(1.1);
    scale: 1.04;
  }
  [data-effect='sand'] .m-reveal {
    -webkit-mask-image: radial-gradient(circle at var(--mx) var(--my), #000 calc(var(--sand) - 12%), transparent var(--sand));
    mask-image: radial-gradient(circle at var(--mx) var(--my), #000 calc(var(--sand) - 12%), transparent var(--sand));
    transition: --sand 1.1s var(--ease-out-expo);
  }
  [data-effect='sand']:is(:hover, :focus-visible, .is-revealed) .m-reveal {
    --sand: 160%;
  }

  /* Starbucks — amanece: la luz sube desde abajo */
  [data-effect='dusk'] .m-base {
    filter: brightness(0.35) saturate(0.5) hue-rotate(-12deg);
  }
  [data-effect='dusk'] .m-reveal {
    -webkit-mask-image: linear-gradient(to top, #000 var(--dawn), transparent calc(var(--dawn) + 28%));
    mask-image: linear-gradient(to top, #000 var(--dawn), transparent calc(var(--dawn) + 28%));
    transition: --dawn 1.2s var(--ease-in-out-quart);
  }
  [data-effect='dusk']:is(:hover, :focus-visible, .is-revealed) .m-reveal {
    --dawn: 100%;
  }
  [data-effect='dusk'] .panel-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 50% 100%, rgb(255 190 120 / 0.35), transparent 70%);
    opacity: 0;
    transition: opacity 1s;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  [data-effect='dusk']:is(:hover, :focus-visible, .is-revealed) .panel-media::after {
    opacity: 1;
  }

  /* ---- Texto ---- */
  .panel-text {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.8rem;
    padding: clamp(1.25rem, 4vw, 3rem);
    container-type: inline-size;
  }
  .panel-num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--p-accent);
  }
  .panel-kicker {
    color: var(--p-muted);
  }
  .panel-title {
    font-size: min(var(--step-5), 21cqi);
    line-height: 0.85;
    margin-block: 0.1em 0.15em;
    overflow-wrap: anywhere;
  }
  .panel-teaser {
    max-width: 38ch;
    font-size: var(--step-0);
    opacity: 0.92;
  }
  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--p-muted);
  }
  .panel-disclaimer {
    font-size: 0.78rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid color-mix(in oklab, var(--p-ink) 30%, transparent);
    border-radius: 3px;
    justify-self: start;
    color: var(--p-ink);
  }
  .panel-cta {
    margin-top: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    text-transform: uppercase;
  }
  .panel-cta span {
    display: inline-block;
    transition: translate 0.5s var(--ease-out-expo);
  }
  .panel:hover .panel-cta span {
    translate: 0.4rem 0;
  }

  @media (min-width: 768px) {
    .panel-media {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1024px) {
    .panel {
      grid-template-columns: 7fr 5fr;
      min-height: min(82vh, 52rem);
    }
    .panel-media {
      aspect-ratio: auto;
      min-height: 100%;
    }
    .panel-item:nth-child(even) .panel {
      grid-template-columns: 5fr 7fr;
    }
    .panel-item:nth-child(even) .panel-media {
      order: 2;
    }
  }
</style>
